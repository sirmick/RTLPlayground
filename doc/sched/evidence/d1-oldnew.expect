# old-vs-new (ovs-rtlpg tests/oldnew, bb0ee65) for D1 against fork main
# b635486: the differences D1 is meant to make. write_char no longer waits
# ~87 us a byte on the wire, so the code after a print runs before its bytes
# are out: the new firmware is a little ahead of the old at the scenarios'
# fixed times. Nothing else may differ (8x and SWGT024).
stp     002 cli stp status        # STP started that much sooner: each port's tx count +1, ages 40/0 for 39/1
stp     005 web GET /stp.json     # its tcs counter, 0x16 for 0x15
stp     006 web GET /stpcnt.json  # the BPDU counters, one more
loop    frames * rldp             # one RLDP probe more per linked port in the window
upload  reg 06f4                  # RTL837X_REG_SEC_COUNTER: the update's reset falls on the other side of a second (8x)
