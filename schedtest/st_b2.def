# schedtest dummies in BANK2 (st_b2.c)
task sleep_b fixed
state SLEEP_B    sleep_b
task poster fixed
state POSTER     poster
task jobber fixed
state JOBBER     jobber
task jb job
state JB_RUN     jb_run
task fl job first=FL_ERASE
state FL_ERASE   fl_erase
state FL_PROG    fl_prog
state FL_VERIFY  fl_verify
state FL_DONE    fl_done
