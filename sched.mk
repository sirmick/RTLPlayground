# sched.mk - the cooperative scheduler (doc/sched/) in every build: its
# sources, the tables generated from the tasks' TASK/STEP markers, the ISR
# frame check. Included by the Makefile after schedtest.mk. The firmware's
# tasks are in tasks.c and flash_job.c; schedtest.mk names its own dummies
# instead.

SCHED_GEN = $(BUILDDIR)/sched
SCHED_STEP_SRCS ?= tasks.c flash_job.c om_job.c
SCHED_DEFS = $(patsubst %.c,$(SCHED_GEN)/%.def,$(notdir $(SCHED_STEP_SRCS)))

# What the ISR prologues push before SWDT_ISR / CRASH_FROM_ISR read SP
# (crash.h); checked against the compiled rtlplayground.asm below.
ISR_T2_PUSHES = 8
ISR_SERIAL_PUSHES = 8
CC_FLAGS += -I$(SCHED_GEN) -DISR_T2_PUSHES=$(ISR_T2_PUSHES) -DISR_SERIAL_PUSHES=$(ISR_SERIAL_PUSHES)

# Resident: the core, the crash record, the dispatch tables. Banked, placed
# by place_banks.py: the rest of the scheduler, health, the tasks' steps;
# the state and slot names in schedtest only (the firmware's are the object
# model's: get prints them), and state.sched's state_task[] in the firmware
# only (schedtest has its own health: --om-words, the words alone).
SCHED_SRCS = sched.c sched_bank.c sched_health.c crash.c sched_gen.c \
	$(if $(SCHEDTEST),sched_gen_names.c,sched_gen_tasks.c) \
	$(if $(SCHEDTEST),,tasks.c flash_job.c om_job.c)
SRCS += $(SCHED_SRCS)
RESIDENT_SRCS += sched.c crash.c sched_gen.c
$(shell mkdir -p $(SCHED_GEN))

# The generated tables (generator.md): the sweep preprocesses the step
# sources with this build's flags into .def files (and the .i text the
# generator checks), every make, rewriting only what changed; it fails on a
# STEP/TASK in any other source of the build, and on a step returning what a
# helper chose; the generator
# runs when those change, and rewrites only the tables that change, so an
# edit that moves no task or state recompiles nothing else. It runs the
# build's own SDCC: in a fresh tree, only once that is built.
$(SCHED_DEFS) $(SCHED_DEFS:.def=.i) &: $(SCHED_STEP_SRCS) tools/sched_sweep.py FORCE | $(SDCC)
	python3 tools/sched_sweep.py -o $(SCHED_GEN) --cpp '$(CC) -E $(CC_FLAGS)' \
		--all $(filter %.c,$(SRCS)) -- $(SCHED_STEP_SRCS) > /dev/null
$(SCHED_GEN)/gen.stamp: $(SCHED_DEFS) $(SCHED_DEFS:.def=.i) tools/sched_gen.py
	python3 tools/sched_gen.py --om $(SCHED_GEN)/om $(if $(SCHEDTEST),--om-words) -o $(SCHED_GEN) $(SCHED_DEFS) > $(SCHED_GEN)/sequence.txt || { cat $(SCHED_GEN)/sequence.txt; exit 1; }
	cat $(SCHED_GEN)/sequence.txt
	touch $@
$(SCHED_GEN)/sched_gen.h $(SCHED_GEN)/sched_gen.c $(SCHED_GEN)/sched_gen_names.c: $(SCHED_GEN)/gen.stamp ;
# the object model's state.sched: its rows (om.mk reads $(SCHED_GEN)/om) and state_task[]
$(SCHED_GEN)/sched_gen_tasks.h $(SCHED_GEN)/sched_gen_tasks.c $(SCHED_GEN)/om/state_sched.py: $(SCHED_GEN)/gen.stamp ;
# A step returns its next state (decision 22): one that can fall off its
# end (SDCC's warning 59) fails the build.
$(patsubst %.c,$(BUILDDIR)/%.rel,$(SCHED_STEP_SRCS)): OBJ_FLAGS += --Werror
$(BUILDDIR)/sched_gen.rel: $(SCHED_GEN)/sched_gen.c $(BUILDDIR)/.ccflags | create_build_dir
	$(CC) -MMD $(CC_FLAGS) $(BANK_FLAGS) -o $@ -c $<
$(BUILDDIR)/sched_gen_names.rel: $(SCHED_GEN)/sched_gen_names.c $(BUILDDIR)/.ccflags | create_build_dir
	$(CC) -MMD $(CC_FLAGS) $(BANK_FLAGS) -o $@ -c $<
$(BUILDDIR)/sched_gen_tasks.rel: $(SCHED_GEN)/sched_gen_tasks.c $(BUILDDIR)/.ccflags | create_build_dir
	$(CC) -MMD $(CC_FLAGS) $(BANK_FLAGS) -o $@ -c $<
$(OBJS): | $(SCHED_GEN)/sched_gen.h
# The Makefile reads DEPS (:=) before this file adds to SRCS: read these
# objects' header dependencies here, or a regenerated sched_gen.h (a slot
# more) leaves them compiled against the old one.
-include $(patsubst %.c,$(BUILDDIR)/%.d,$(SCHED_SRCS) $(ST_SRCS))

# This build's identity, for the crash record (crash.h): a record another
# image left in xdata (a web update, a schedtest image, another build of the
# same commit) is ignored at boot. 32 bits of the version, the build date and
# the build directory (machine, layout, schedtest and its variants).
CRASH_IMAGE := $(shell printf '%s' '$(VERSION_EXTENSION) $(BUILD_DATE) $(BUILDDIR)' | sha1sum | cut -c1-8)
$(SCHED_GEN)/build_id.h: FORCE
	@printf '%s\n' "/* generated by sched.mk: this build's identity (crash.h) */" \
		"#define CRASH_IMAGE_HI 0x$(shell echo $(CRASH_IMAGE) | cut -c1-4)" \
		"#define CRASH_IMAGE_LO 0x$(shell echo $(CRASH_IMAGE) | cut -c5-8)" > $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv $@.tmp $@
$(BUILDDIR)/crash.rel $(BUILDDIR)/sched_health.rel: $(SCHED_GEN)/build_id.h

# The PC in the crash record is only right if the push counts are
$(BUILDDIR)/isr_frame.ok: $(BUILDDIR)/rtlplayground.rel tools/isr_frame.py
	python3 tools/isr_frame.py $(BUILDDIR)/rtlplayground.asm \
		isr_timer2=$(ISR_T2_PUSHES) isr_serial=$(ISR_SERIAL_PUSHES)
	@touch $@
$(BUILDDIR)/placed.stamp: $(BUILDDIR)/isr_frame.ok

# SDCC 4.6.0 drops a STEP_SLEEP(STEP_STAY, ..)'s call unless sched.h casts the
# state: the probe, compiled with this build's flags (not linked), keeps it so.
$(BUILDDIR)/step_probe.ok: tools/step_probe.c tools/step_probe.py sched.h $(SCHED_GEN)/sched_gen.h | create_build_dir
	$(CC) $(CC_FLAGS) -o $(BUILDDIR)/step_probe.rel -c tools/step_probe.c
	python3 tools/step_probe.py $(BUILDDIR)/step_probe.asm
	@touch $@
$(BUILDDIR)/placed.stamp: $(BUILDDIR)/step_probe.ok
